build/
install/
log/
__pycache__/
*.pyc
*.pyo
*.swp
*.tmp

# Local upstream checkout; keep it on disk but never add it to this repo.
vendor/openarm/openarm_teleop/

# 배포 파이썬 환경(setup_deploy_env.sh 로 재생성)
.venv/

# 구운 rosbag2 (npz 에서 action_bag.py 로 언제든 재생성 — 커밋하지 않는다)
logs/shadow/*.bag/

# rosbag2 원본 (수백 MB~GB). 판정 결과는 docs/ 와 분석 CSV 로 남는다
logs/rosbags/
logs/shadow/rosbags/

# 정책 체크포인트 바이너리 — 진실원천은 hdgp/log/. 여기엔 params dump 와 README 만 둔다
logs/policy/**/*.pth

# 미션 실행 기록 (state.json/jsonl/pids) — 런타임 상태이지 산출물이 아니다
logs/mission/

# policy_control 실행 로그 (fake plant·체인 리코더 npz/csv/log, 197MB+) —
# 판정 결과는 docs/ 와 tests/fixtures/ 의 골든에 남는다
logs/policy_control/

# 실기 라운드 rosbag2 (수 GB). 판정·분석 결과는 docs/ 와 npz 트레이스로 남는다
logs/bags/

# 정책 가중치 — 배포 스냅샷은 md5 로 문서에 못 박고 파일은 커밋하지 않는다
logs/policy/**/nn/*.pth

# 학습 런의 골든 트레이스 (수백 MB). 계약·해시는 커밋하고 트레이스는 fetch_run.py 로 다시 받는다:
#   policy_control/tools/fetch_run.py --run <label> --checkpoint ep:NNNN --trace auto --out logs/policy/<run>
logs/policy/**/trace.npz
# policies/ — 배포 후보 정책 등록소 (policy_control/tools/fetch_run.py 가 채운다).
#   카드(policy.yaml)·fetch.json·params·계약은 추적하고, 무거운 산출물만 뺀다.
policies/**/nn/*.pth
policies/**/*.npz
policies/**/summaries/
policies/**/.staging_*/
tests/fixtures/policy_control/**/trace.npz

# 2026-09-22 구조 정리 — 파일은 디스크에 남기고 추적만 뗀다
#   checkpoints/: 참조 0 인 옛 grasp_v1 가중치(LFS). 가중치의 집은 policies/ 다
checkpoints/
#   pour_entry 리허설 GIF: README 가 '정본' 이라 부르는 폐루프 기록 하나만 추적한다
logs/shadow/pour_entry/*.gif
!logs/shadow/pour_entry/bimanual_closedloop.gif
