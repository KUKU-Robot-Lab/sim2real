+
+def bag_topics(side):
+    """분석(S.aligned_samples · 마찰 스크립트)이 읽는 토픽."""
+    return (
+        "/joint_states", "/head/joint_states", f"/hand_{side}/joint_states",
+        "/policy_control/joint_target", f"/policy_control/status/pd_{side}",
+        f"/policy_control/pd_{side}/diagnostics",
+    )
