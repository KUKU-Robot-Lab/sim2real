<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast-DDS 프로파일 틀 — DDS 를 허브 랜 NIC(@LAN_IP@) 한 곳에 묶는다. config/dds/lan_profile.sh 가 이 틀에서 만들고
     FASTRTPS_DEFAULT_PROFILES_FILE 로 내보낸다. 같은 호스트끼리는 SHM.
     요소 이름은 Fast-DDS 2.6(humble)이 받는 interfaceWhiteList(대문자 L)여야 한다. 소문자 l 은 XMLPARSER 오류로 무시된다(10.30 실측). -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>s2r_lan_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>@LAN_IP@</address></interfaceWhiteList>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>s2r_shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="s2r_lan_only" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>s2r_lan_udp</transport_id><transport_id>s2r_shm</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
